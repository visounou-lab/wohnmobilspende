# ---------------------------------------------------------------------------
# Wohnmobilspende – Environment Variables
# Kopiere diese Datei nach `.env` (lokal) bzw. trage die Werte in den
# Vercel Environment Variables ein. NIEMALS echte Secrets committen.
# ---------------------------------------------------------------------------

# --- Datenbank (Neon Postgres bei Vercel) ---------------------------------
# Bei Nutzung der Neon-Integration in Vercel werden diese Variablen automatisch
# gesetzt – dann ist hier nichts weiter zu tun.
#
# Pooled-Verbindung (mit -pooler im Host) für die Anwendung zur Laufzeit.
# (Prisma ergänzt bei Bedarf automatisch pgbouncer=true.)
DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direkte Verbindung (ohne -pooler) für `prisma db push` / Migrationen.
# Die Neon-Integration nennt diese Variable DATABASE_URL_UNPOOLED – beide werden
# vom Build automatisch erkannt. Für lokale Migrationen genügt eine davon.
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Öffentliche Basis-URL der Website ------------------------------------
# Wird für Canonical-URLs, Sitemap, Open Graph und E-Mail-Links verwendet.
NEXT_PUBLIC_SITE_URL="https://wohnmobilspende.site"

# --- E-Mail-Versand (Resend) — WICHTIG ------------------------------------
# Die gesamte Verwaltung der Bewerbungen erfolgt per E-Mail. Ohne diese Werte
# werden KEINE Bewerbungen zugestellt (sie werden lediglich in der DB
# gespeichert). Daher unbedingt konfigurieren.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Absenderadresse – die Domain muss in Resend verifiziert sein.
EMAIL_FROM="Wohnmobilspende <bewerbung@wohnmobilspende.site>"
# Adresse(n), an die jede vollständige Bewerbung + Kontaktnachricht geht.
# Mehrere Empfänger durch Komma trennen (z. B. Privat + berufliche Adresse).
EMAIL_ADMIN="elisabeth@example.com, info@pro-adresse.de"

# --- Anti-Spam / CAPTCHA (Cloudflare Turnstile, optional aber empfohlen) ---
# Ohne diese Werte greift der eingebaute Honeypot-/Zeitfallen-Schutz.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
