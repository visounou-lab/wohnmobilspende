// Wohnmobilspende – Prisma Schema
// Datenbank: Neon Postgres (bereitgestellt über Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Schlanke Bewerbung – schnell auszufüllen. Der Kern ist die Geschichte.
model Application {
  id                String   @id @default(cuid())
  applicationNumber String   @unique // z. B. WS-DE-2026-0001

  firstName         String
  lastName          String
  email             String
  phone             String
  city              String
  state             String // Bundesland
  applicantType     String // Familie / Einzelperson / Organisation / Soziales Projekt
  hasLicense        Boolean
  story             String   @db.Text // die persönliche Geschichte

  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum DonationStatus {
  VERFUEGBAR // Verfügbar
  IN_VERMITTLUNG // In Vermittlung
  VERGEBEN // Vergeben
}

// Weitere Sachspenden ("Weitere Dinge, die ein neues Zuhause suchen").
model Donation {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  category       String
  location       String // Aktueller Standort
  handoverRegion String // Mögliche Übergaberegion
  imageUrl       String?
  status         DonationStatus @default(VERFUEGBAR)
  published      Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([published, sortOrder])
}

// Fortlaufende Zähler (z. B. pro Jahr) für die Bewerbungsnummer.
model Counter {
  key   String @id // z. B. "application-2026"
  value Int    @default(0)
}
