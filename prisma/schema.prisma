// Wohnmobilspende – Prisma Schema
// Datenbank: Neon Postgres (bereitgestellt über Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Status einer Bewerbung – spiegelt die Dashboard-Kategorien wider.
enum ApplicationStatus {
  NEU // Neue Bewerbungen
  IN_PRUEFUNG // In Prüfung
  KONTAKT // Kontakt aufnehmen
  VORAUSWAHL // Vorauswahl
  NICHT_AUSGEWAEHLT // Nicht ausgewählt
  AUSGEWAEHLT // Ausgewählt
}

// Antwortoptionen mit "Ja / Nein / weitere Info" bzw. "abhängig".
enum TriState {
  JA
  NEIN
  INFO // "Ich benötige weitere Informationen" / "Abhängig vom Standort"
}

model Application {
  id                String            @id @default(cuid())
  applicationNumber String            @unique // z. B. WS-DE-2026-0001

  // Schritt 1 – Über Sie
  firstName         String
  lastName          String
  birthDate         String // als ISO-String gespeichert (Datenminimierung, kein exaktes Datum nötig)
  city              String
  state             String // Bundesland
  country           String            @default("Deutschland")
  phone             String
  email             String

  // Schritt 2 – Ihre Situation
  maritalStatus     String
  occupation        String
  householdSize     Int
  hasLicense        Boolean
  hadMotorhome      Boolean

  // Schritt 3 – Ihre Geschichte
  motivation        String            @db.Text // Warum möchten Sie dieses Wohnmobil erhalten?
  plannedUse        String            @db.Text // Wie würden Sie es nutzen?
  impact            String            @db.Text // Was würde sich verändern?
  aboutYou          String            @db.Text // Über sich / Familie / Projekt

  // Schritt 4 – Verantwortung
  canMaintain       Boolean
  canInsure         TriState
  willingToTalk     Boolean
  canOrganizeHandover TriState

  // Verwaltung
  status            ApplicationStatus @default(NEU)
  internalNotes     String?           @db.Text

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum DonationStatus {
  VERFUEGBAR // Verfügbar
  IN_VERMITTLUNG // In Vermittlung
  VERGEBEN // Vergeben
}

// Weitere Sachspenden ("Weitere Dinge, die ein neues Zuhause suchen").
model Donation {
  id             String         @id @default(cuid())
  title          String
  description    String         @db.Text
  category       String
  location       String // Aktueller Standort
  handoverRegion String // Mögliche Übergaberegion
  imageUrl       String?
  status         DonationStatus @default(VERFUEGBAR)
  published      Boolean        @default(true)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([published, sortOrder])
}

// Fortlaufende Zähler (z. B. pro Jahr) für die Bewerbungsnummer.
model Counter {
  key   String @id // z. B. "application-2026"
  value Int    @default(0)
}
